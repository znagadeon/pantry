{
  "name": "@pantrykb/core",
  "version": "0.1.0",
  "description": "pantry의 순정 코어 — .md ingredient에 대한 6개 동사와 lexical query. AI를 위한 개인용 knowledge base.",
  "license": "MIT",
  "author": "Kim Songhyun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/znagadeon/pantry.git",
    "directory": "packages/core"
  },
  "keywords": ["pantry", "knowledge-base", "zettelkasten", "markdown", "notes"],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "LICENSE"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
