{
  "name": "@pantrykb/cli",
  "version": "0.1.0",
  "description": "pantry CLI — AI를 위한 개인용 knowledge base. `pantry` 명령으로 .md 노트를 create/query/read/fix/deprecate/delete하고 plugin으로 확장한다.",
  "license": "MIT",
  "author": "Kim Songhyun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/znagadeon/pantry.git",
    "directory": "packages/cli"
  },
  "keywords": ["pantry", "knowledge-base", "zettelkasten", "markdown", "notes", "cli"],
  "type": "module",
  "bin": {
    "pantry": "./dist/bin.js"
  },
  "files": ["dist", "LICENSE"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/bin.ts"
  },
  "dependencies": {
    "@pantrykb/core": "workspace:*"
  }
}
